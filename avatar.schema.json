{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Little Shape Avatar Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1, "default": 1},
    "shape": {"enum": ["circle","oval","square","capsule","triangle","hexagon","cloud","drop"], "default": "drop"},
    "color": {"enum": ["black","brown","red","orange","yellow","green","teal","blue","purple","pink","gray"], "default": "brown"},
    "size": {"type": "integer", "minimum": 64, "maximum": 4096, "default": 1024},
    "padding": {"type": "number", "minimum": 0, "maximum": 40, "default": 16},
    "background": {"enum": ["transparent","white"], "default": "transparent"}
  }
}
