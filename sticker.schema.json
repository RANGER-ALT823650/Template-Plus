{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Template Plus Sticker Layout",
  "description": "GUI/CLI shared version 1 layout. CLI validate additionally checks embedded SVG/PNG safety, duplicate IDs and the 32 MB limit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "objects"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "model": {
      "enum": [
        "iphone-air",
        "iphone-17-pro",
        "iphone-17-pro-max",
        "iphone-18-pro",
        "iphone-18-pro-max"
      ],
      "default": "iphone-air"
    },
    "name": {
      "type": "string",
      "maxLength": 80
    },
    "objects": {
      "type": "array",
      "maxItems": 100,
      "description": "Back-to-front paint order.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "type",
              "x",
              "y",
              "width",
              "rotation",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w-]{1,80}$"
              },
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "type": {
                "const": "avatar"
              },
              "x": {
                "type": "number",
                "minimum": -100,
                "maximum": 165
              },
              "y": {
                "type": "number",
                "minimum": -100,
                "maximum": 124
              },
              "width": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 150
              },
              "rotation": {
                "type": "number",
                "minimum": -360,
                "maximum": 360
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "version": {
                    "const": 1,
                    "default": 1
                  },
                  "shape": {
                    "enum": [
                      "circle",
                      "oval",
                      "square",
                      "capsule",
                      "triangle",
                      "hexagon",
                      "cloud",
                      "drop",
                      "sparkle",
                      "clover",
                      "heart",
                      "flower",
                      "pentagon",
                      "star"
                    ],
                    "default": "drop"
                  },
                  "color": {
                    "enum": [
                      "black",
                      "brown",
                      "red",
                      "orange",
                      "yellow",
                      "green",
                      "teal",
                      "blue",
                      "purple",
                      "pink",
                      "gray"
                    ],
                    "default": "brown"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 64,
                    "maximum": 4096,
                    "default": 1024
                  },
                  "padding": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 40,
                    "default": 16
                  },
                  "background": {
                    "enum": [
                      "transparent",
                      "white"
                    ],
                    "default": "transparent"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "type",
              "x",
              "y",
              "width",
              "rotation",
              "svg"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w-]{1,80}$"
              },
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "type": {
                "const": "svg"
              },
              "x": {
                "type": "number",
                "minimum": -100,
                "maximum": 165
              },
              "y": {
                "type": "number",
                "minimum": -100,
                "maximum": 124
              },
              "width": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 150
              },
              "rotation": {
                "type": "number",
                "minimum": -360,
                "maximum": 360
              },
              "svg": {
                "type": "string",
                "maxLength": 200000
              },
              "ratio": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "type",
              "x",
              "y",
              "width",
              "rotation",
              "dataUrl"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w-]{1,80}$"
              },
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "type": {
                "const": "png"
              },
              "x": {
                "type": "number",
                "minimum": -100,
                "maximum": 165
              },
              "y": {
                "type": "number",
                "minimum": -100,
                "maximum": 124
              },
              "width": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 150
              },
              "rotation": {
                "type": "number",
                "minimum": -360,
                "maximum": 360
              },
              "dataUrl": {
                "type": "string",
                "pattern": "^data:image/png;base64,[A-Za-z0-9+/]+={0,2}$"
              },
              "ratio": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "pixelWidth": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8192
              },
              "pixelHeight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8192
              }
            }
          }
        ]
      }
    }
  }
}
